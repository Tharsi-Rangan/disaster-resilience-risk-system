{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "set NODE_ENV=test && jest --detectOpenHandles --forceExit",
    "test:unit": "set NODE_ENV=test && jest --testPathPatterns=src/__tests__ --verbose --forceExit",
    "test:integration": "set NODE_ENV=test && jest --testPathPatterns=\"mitigation.integration|project.integration\" --verbose --forceExit",
    "test:performance": "artillery run artillery.mitigation.yml --output artillery-report.json",
    "test:performance:project": "artillery run artillery.project.yml --output artillery-project-report.json",
    "test:performance:project:report": "artillery report artillery-project-report.json --output artillery-project-report.html",
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.1",
    "nodemailer": "^8.0.1"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
